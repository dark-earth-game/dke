#include <idc.idc>

extern g_nf, g_nd, g_ty, g_fail;

static nf(ea, name)
{
  auto s = get_func_attr(ea, FUNCATTR_START);
  if (s == BADADDR) { if (!add_func(ea, BADADDR)) msg("add_func fail %x\n", ea); }
  if (set_name(ea, name, SN_NOWARN|SN_NOCHECK)) g_nf++; else { g_fail++; msg("name fail %x %s\n", ea, name); }
}

static nd(ea, name)
{
  if (set_name(ea, name, SN_NOWARN|SN_NOCHECK)) g_nd++; else { g_fail++; msg("name fail %x %s\n", ea, name); }
}

static ty(ea, decl)
{
  if (SetType(ea, decl)) g_ty++; else msg("type fail %x\n", ea);
}

