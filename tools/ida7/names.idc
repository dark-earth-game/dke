static main()
{
  auto h;
  g_nf = 0; g_nd = 0; g_ty = 0; g_fail = 0;
  msg("names.idc: start\n");
  // NOTE: edit the path below if types.h is moved
  h = parse_decls("types.h", PT_FILE);
  msg("parse_decls errors: %d\n", h);
  part0();
  part1();
  part2();
  part3();
  part4();
  part5();
  part6();
  msg("names.idc: funcs+data named %d/%d, types %d, failures %d\n", g_nf, g_nd, g_ty, g_fail);
  auto_wait();
  qexit(0);
}
